// Draft constraints for full_system_top.
// Base camera pins are copied from camera_hdmi_SVGA_800x600_RGB/src/dk_video.cst.
// Flash pins are copied from output_final/constraints/nn_system_standalone_pocket_slowmem.cst.
//
// Notes:
// - O_led[1:0] and seg[7:0] are intentionally NOT exported in the current
//   IO-reduced direct-SPI top.
// - Bank 3 is locked to 1.8V by embedded/board constraints, so I_rst_n,
//   KEY_STEP_N, and active bank-3 PIXDATA[7:2] must use LVCMOS18.
// - TMDS uses ELVDS_TBUF pair-style constraints.

// -----------------------------------------------------------------------------
// Clock / reset / buttons
// -----------------------------------------------------------------------------

IO_LOC "I_clk" 45;
IO_PORT "I_clk" IO_TYPE=LVCMOS33;

IO_LOC "I_rst_n" 14;
IO_PORT "I_rst_n" IO_TYPE=LVCMOS18;

// Existing camera project used pin 15 as "key"; standalone used it as KEY_COUNT_N.
IO_LOC "KEY_STEP_N" 15;
IO_PORT "KEY_STEP_N" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// KEY_RESET_N is intentionally not a top-level port in this IO-reduced build.
// Use I_rst_n for physical reset; the FSM reset pulse is tied inactive inside RTL.

// -----------------------------------------------------------------------------
// Debug LEDs / seven-segment outputs are disabled to reduce GPIO count
// -----------------------------------------------------------------------------

// IO_LOC "O_led[0]" 10;
// IO_PORT "O_led[0]" IO_TYPE=LVCMOS33;
// IO_LOC "O_led[1]" <pin>;
// IO_PORT "O_led[1]" IO_TYPE=LVCMOS33;

// TODO: seg[7:0] are internal only in the IO-reduced build.
// IO_LOC "seg[0]" <pin>;
// IO_LOC "seg[1]" <pin>;
// IO_LOC "seg[2]" <pin>;
// IO_LOC "seg[3]" <pin>;
// IO_LOC "seg[4]" <pin>;
// IO_LOC "seg[5]" <pin>;
// IO_LOC "seg[6]" <pin>;
// IO_LOC "seg[7]" <pin>;

// -----------------------------------------------------------------------------
// HDMI / TMDS
// -----------------------------------------------------------------------------

IO_LOC "O_tmds_clk_p" 28,27;
IO_PORT "O_tmds_clk_p" PULL_MODE=NONE;

IO_LOC "O_tmds_data_p[0]" 30,29;
IO_PORT "O_tmds_data_p[0]" PULL_MODE=NONE;

IO_LOC "O_tmds_data_p[1]" 32,31;
IO_PORT "O_tmds_data_p[1]" PULL_MODE=NONE;

IO_LOC "O_tmds_data_p[2]" 35,34;
IO_PORT "O_tmds_data_p[2]" PULL_MODE=NONE;

// -----------------------------------------------------------------------------
// OV2640 camera
// -----------------------------------------------------------------------------

IO_LOC "XCLK" 33;
IO_PORT "XCLK" IO_TYPE=LVCMOS33;

IO_LOC "SCL" 44;
IO_PORT "SCL" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "SDA" 46;
IO_PORT "SDA" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "PIXCLK" 41;
IO_PORT "PIXCLK" IO_TYPE=LVCMOS33;

IO_LOC "HREF" 42;
IO_PORT "HREF" IO_TYPE=LVCMOS33;

IO_LOC "VSYNC" 43;
IO_PORT "VSYNC" IO_TYPE=LVCMOS33;

IO_LOC "PIXDATA[9]" 40;
IO_PORT "PIXDATA[9]" IO_TYPE=LVCMOS33;

IO_LOC "PIXDATA[8]" 39;
IO_PORT "PIXDATA[8]" IO_TYPE=LVCMOS33;

IO_LOC "PIXDATA[7]" 23;
IO_PORT "PIXDATA[7]" IO_TYPE=LVCMOS18;

IO_LOC "PIXDATA[6]" 16;
IO_PORT "PIXDATA[6]" IO_TYPE=LVCMOS18;

IO_LOC "PIXDATA[5]" 18;
IO_PORT "PIXDATA[5]" IO_TYPE=LVCMOS18;

IO_LOC "PIXDATA[4]" 20;
IO_PORT "PIXDATA[4]" IO_TYPE=LVCMOS18;

IO_LOC "PIXDATA[3]" 19;
IO_PORT "PIXDATA[3]" IO_TYPE=LVCMOS18;

IO_LOC "PIXDATA[2]" 17;
IO_PORT "PIXDATA[2]" IO_TYPE=LVCMOS18;

// -----------------------------------------------------------------------------
// SPI Flash for direct NN parameter stream
// -----------------------------------------------------------------------------

// NN compile-only variant: leave debug/flash-observe pins unconstrained.
// The main branch still uses the board MSPI pin constraints.
