// IO_PORT "FLASH_SCLK" IO_TYPE=LVCMOS33;

// IO_LOC "FLASH_CS_N" 2;
// IO_PORT "FLASH_CS_N" IO_TYPE=LVCMOS33;

// IO_LOC "FLASH_MOSI" 48;
// IO_PORT "FLASH_MOSI" IO_TYPE=LVCMOS33;

// IO_LOC "FLASH_MISO" 47;
// IO_PORT "FLASH_MISO" IO_TYPE=LVCMOS33;
